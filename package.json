{
  "name": "vscode-xgwx",
  "displayName": "XGWX Workspace Editor",
  "description": "Inspect and safely edit supported LS XG5000 .xgwx program data.",
  "version": "0.1.0",
  "publisher": "ne0ekspert",
  "license": "Apache-2.0",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "xgwx",
    "xg5000",
    "plc",
    "ls-electric"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onCustomEditor:xgwx.workspaceViewer"
  ],
  "contributes": {
    "customEditors": [
      {
        "viewType": "xgwx.workspaceViewer",
        "displayName": "XGWX Workspace Editor",
        "selector": [
          {
            "filenamePattern": "*.xgwx"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "xgwx.refreshViewer",
        "title": "XGWX: Refresh Workspace Viewer",
        "icon": "$(refresh)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "xgwx.refreshViewer",
          "when": "activeCustomEditorId == xgwx.workspaceViewer",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "check": "node --check extension.js && node --check media/main.js",
    "test": "node --test test/*.test.js test/*.test.mjs",
    "build:wasm": "bash scripts/build-wasm.sh",
    "package": "npx @vscode/vsce package"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.6.0"
  }
}
