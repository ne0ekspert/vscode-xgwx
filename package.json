{
  "name": "vscode-xgwx",
  "displayName": "XGWX Workspace Editor",
  "description": "Inspect and safely edit supported LS XG5000 .xgwx program data.",
  "version": "0.1.0",
  "publisher": "ne0ekspert",
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/ne0ekspert/vscode-xgwx.git"
  },
  "homepage": "https://github.com/ne0ekspert/vscode-xgwx#readme",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "xgwx",
    "xg5000",
    "plc",
    "ls-electric"
  ],
  "main": "./extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    }
  },
  "activationEvents": [
    "onCustomEditor:xgwx.workspaceViewer",
    "onStartupFinished"
  ],
  "contributes": {
    "customEditors": [
      {
        "viewType": "xgwx.workspaceViewer",
        "displayName": "XGWX Workspace Editor",
        "selector": [
          {
            "filenamePattern": "*.xgwx"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "xgwx.refreshViewer",
        "title": "XGWX: Refresh Workspace Viewer",
        "icon": "$(refresh)"
      },
      {
        "command": "xgwx.newFile",
        "title": "XGWX: New File",
        "icon": "$(new-file)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "xgwx.refreshViewer",
          "when": "activeCustomEditorId == xgwx.workspaceViewer",
          "group": "navigation"
        }
      ],
      "file/newFile": [
        {
          "command": "xgwx.newFile",
          "group": "file@10"
        }
      ]
    },
    "languages": [
      {
        "id": "xgwx-st",
        "aliases": [
          "Structured Text (XG5000)",
          "ST"
        ],
        "extensions": [
          ".st"
        ],
        "configuration": "./syntaxes/iec-language-configuration.json"
      },
      {
        "id": "xgwx-il",
        "aliases": [
          "Instruction List (XG5000)",
          "IL"
        ],
        "extensions": [
          ".il"
        ],
        "configuration": "./syntaxes/iec-language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "xgwx-st",
        "scopeName": "source.xgwx-st",
        "path": "./syntaxes/st.tmLanguage.json"
      },
      {
        "language": "xgwx-il",
        "scopeName": "source.xgwx-il",
        "path": "./syntaxes/il.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "xgwx-st",
        "path": "./snippets/st.json"
      },
      {
        "language": "xgwx-il",
        "path": "./snippets/il.json"
      }
    ]
  },
  "scripts": {
    "check": "node --check extension.js && node --check media/main.js && node --check scripts/launch-extension-host.cjs && node --check media/ladder-operand-rules.cjs && node --check media/variable-edit.js && node --check new-workspace.cjs",
    "test": "node --test test/*.test.js test/*.test.mjs",
    "build:wasm": "bash scripts/build-wasm.sh",
    "package": "npx @vscode/vsce package",
    "build:text-templates": "node scripts/build-text-project-templates.mjs"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.6.0"
  }
}
