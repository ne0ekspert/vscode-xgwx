{
  "name": "vscode-xgwx",
  "displayName": "XGWX Workspace Editor",
  "description": "Inspect and safely edit supported LS XG5000 .xgwx program data.",
  "version": "0.1.0",
  "publisher": "ne0ekspert",
  "icon": "media/icon.png",
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/ne0ekspert/vscode-xgwx.git"
  },
  "homepage": "https://github.com/ne0ekspert/vscode-xgwx#readme",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "xgwx",
    "xg5000",
    "plc",
    "ls-electric"
  ],
  "main": "./extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    }
  },
  "activationEvents": [
    "onCustomEditor:xgwx.workspaceViewer",
    "onStartupFinished"
  ],
  "contributes": {
    "customEditors": [
      {
        "viewType": "xgwx.workspaceViewer",
        "displayName": "XGWX Workspace Editor",
        "selector": [
          {
            "filenamePattern": "*.xgwx"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "xgwx.refreshViewer",
        "title": "XGWX: Refresh Workspace Viewer",
        "icon": "$(refresh)"
      },
      {
        "command": "xgwx.newFile",
        "title": "XGWX: New File",
        "icon": "$(new-file)"
      },
      {
        "command": "xgwx.explorerCreateProgram",
        "title": "Create Program",
        "icon": "$(add)"
      },
      {
        "command": "xgwx.explorerDeleteProgram",
        "title": "Delete Program",
        "icon": "$(trash)"
      },
      {
        "command": "xgwx.editXgkIl",
        "title": "Edit XGK IL",
        "category": "XGWX",
        "enablement": "activeCustomEditorId == xgwx.workspaceViewer"
      },
      {
        "command": "xgwx.showXgkLadder",
        "title": "Show XGK Ladder",
        "category": "XGWX",
        "enablement": "activeCustomEditorId == xgwx.workspaceViewer"
      },
      {
        "command": "xgwx.find",
        "title": "Find in Program or Variables",
        "category": "XGWX",
        "enablement": "activeCustomEditorId == xgwx.workspaceViewer"
      },
      {
        "command": "xgwx.viewValues.unsigned",
        "title": "View Values as Unsigned",
        "category": "XGWX",
        "enablement": "activeCustomEditorId == xgwx.workspaceViewer"
      },
      {
        "command": "xgwx.viewValues.signed",
        "title": "View Values as Signed",
        "category": "XGWX",
        "enablement": "activeCustomEditorId == xgwx.workspaceViewer"
      },
      {
        "command": "xgwx.viewValues.hex",
        "title": "View Values as Hexadecimal",
        "category": "XGWX",
        "enablement": "activeCustomEditorId == xgwx.workspaceViewer"
      },
      {
        "command": "xgwx.viewValues.float",
        "title": "View Values as Float",
        "category": "XGWX",
        "enablement": "activeCustomEditorId == xgwx.workspaceViewer"
      },
      {
        "command": "xgwx.viewValues.source",
        "title": "View Values as Source",
        "category": "XGWX",
        "enablement": "activeCustomEditorId == xgwx.workspaceViewer"
      },
      {
        "command": "xgwx.explorerSetProgramPassword",
        "title": "Set password",
        "icon": "$(key)"
      },
      {
        "command": "xgwx.explorerChangeProgramPassword",
        "title": "Change password",
        "icon": "$(key)"
      },
      {
        "command": "xgwx.explorerRemoveProgramPassword",
        "title": "Remove password",
        "icon": "$(key)"
      },
      {
        "command": "xgwx.explorerUnlockProgramPassword",
        "title": "Unlock program",
        "icon": "$(key)"
      },
      {
        "command": "xgwx.explorerSetProjectPassword",
        "title": "Set password",
        "icon": "$(key)"
      },
      {
        "command": "xgwx.explorerChangeProjectPassword",
        "title": "Change password",
        "icon": "$(key)"
      },
      {
        "command": "xgwx.explorerRemoveProjectPassword",
        "title": "Remove password",
        "icon": "$(key)"
      },
      {
        "command": "xgwx.explorerCreateTask",
        "title": "Create Task",
        "icon": "$(add)"
      },
      {
        "command": "xgwx.explorerEditTask",
        "title": "Task Properties",
        "icon": "$(settings-gear)"
      },
      {
        "command": "xgwx.explorerDeleteTask",
        "title": "Delete Task",
        "icon": "$(trash)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "xgwx.refreshViewer",
          "when": "activeCustomEditorId == xgwx.workspaceViewer",
          "group": "navigation"
        }
      ],
      "file/newFile": [
        {
          "command": "xgwx.newFile",
          "group": "file@10"
        }
      ],
      "view/item/context": [
        {
          "command": "xgwx.explorerCreateProgram",
          "when": "view == xgwx.explorer && (viewItem == xgwxPrograms || viewItem == xgwxPrograms.tasks || viewItem =~ /^xgwxTask\\.(scan|user|empty)\\.programs$/)",
          "group": "navigation"
        },
        {
          "command": "xgwx.explorerDeleteProgram",
          "when": "view == xgwx.explorer && (viewItem == xgwxProgram.passwordNone || viewItem == xgwxProgram.passwordLocked || viewItem == xgwxProgram.passwordOpen)",
          "group": "navigation"
        },
        {
          "command": "xgwx.explorerSetProgramPassword",
          "when": "view == xgwx.explorer && viewItem == xgwxProgram.passwordNone",
          "group": "password@2"
        },
        {
          "command": "xgwx.explorerChangeProgramPassword",
          "when": "view == xgwx.explorer && (viewItem == xgwxProgram.passwordLocked || viewItem == xgwxProgram.passwordOpen)",
          "group": "password@3"
        },
        {
          "command": "xgwx.explorerRemoveProgramPassword",
          "when": "view == xgwx.explorer && (viewItem == xgwxProgram.passwordLocked || viewItem == xgwxProgram.passwordOpen)",
          "group": "password@4"
        },
        {
          "command": "xgwx.explorerUnlockProgramPassword",
          "when": "view == xgwx.explorer && viewItem == xgwxProgram.passwordLocked",
          "group": "password@1"
        },
        {
          "command": "xgwx.explorerSetProjectPassword",
          "when": "view == xgwx.explorer && viewItem == xgwxProject.passwordNone",
          "group": "password@2"
        },
        {
          "command": "xgwx.explorerChangeProjectPassword",
          "when": "view == xgwx.explorer && viewItem == xgwxProject.passwordSet",
          "group": "password@3"
        },
        {
          "command": "xgwx.explorerRemoveProjectPassword",
          "when": "view == xgwx.explorer && viewItem == xgwxProject.passwordSet",
          "group": "password@4"
        },
        {
          "command": "xgwx.explorerCreateTask",
          "when": "view == xgwx.explorer && viewItem == xgwxPrograms.tasks",
          "group": "navigation@1"
        },
        {
          "command": "xgwx.explorerEditTask",
          "when": "view == xgwx.explorer && viewItem =~ /^xgwxTask\\./",
          "group": "navigation@2"
        },
        {
          "command": "xgwx.explorerDeleteTask",
          "when": "view == xgwx.explorer && viewItem =~ /^xgwxTask\\.empty\\./",
          "group": "navigation@3"
        }
      ],
      "commandPalette": [
        {
          "command": "xgwx.editXgkIl",
          "when": "activeCustomEditorId == xgwx.workspaceViewer"
        },
        {
          "command": "xgwx.showXgkLadder",
          "when": "activeCustomEditorId == xgwx.workspaceViewer"
        },
        {
          "command": "xgwx.explorerSetProgramPassword",
          "when": "false"
        },
        {
          "command": "xgwx.explorerChangeProgramPassword",
          "when": "false"
        },
        {
          "command": "xgwx.explorerRemoveProgramPassword",
          "when": "false"
        },
        {
          "command": "xgwx.explorerUnlockProgramPassword",
          "when": "false"
        },
        {
          "command": "xgwx.explorerSetProjectPassword",
          "when": "false"
        },
        {
          "command": "xgwx.explorerChangeProjectPassword",
          "when": "false"
        },
        {
          "command": "xgwx.explorerRemoveProjectPassword",
          "when": "false"
        },
        {
          "command": "xgwx.explorerCreateTask",
          "when": "false"
        },
        {
          "command": "xgwx.explorerEditTask",
          "when": "false"
        },
        {
          "command": "xgwx.explorerDeleteTask",
          "when": "false"
        },
        {
          "command": "xgwx.explorerCreateProgram",
          "when": "false"
        }
      ]
    },
    "languages": [
      {
        "id": "xgwx-st",
        "aliases": [
          "Structured Text (XG5000)",
          "ST"
        ],
        "extensions": [
          ".st"
        ],
        "configuration": "./syntaxes/iec-language-configuration.json"
      },
      {
        "id": "xgwx-il",
        "aliases": [
          "Instruction List (XG5000)",
          "IL"
        ],
        "extensions": [
          ".il"
        ],
        "configuration": "./syntaxes/iec-language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "xgwx-st",
        "scopeName": "source.xgwx-st",
        "path": "./syntaxes/st.tmLanguage.json"
      },
      {
        "language": "xgwx-il",
        "scopeName": "source.xgwx-il",
        "path": "./syntaxes/il.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "xgwx-st",
        "path": "./snippets/st.json"
      },
      {
        "language": "xgwx-il",
        "path": "./snippets/il.json"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "xgwx.explorer",
          "name": "XG5000 Explorer",
          "contextualTitle": "XG5000"
        }
      ]
    },
    "keybindings": [
      {
        "command": "xgwx.find",
        "key": "ctrl+f",
        "mac": "cmd+f",
        "when": "activeCustomEditorId == xgwx.workspaceViewer && !inputFocus"
      }
    ],
    "configuration": {
      "title": "XGWX",
      "properties": {
        "xgwx.hexPrefix": {
          "type": "string",
          "enum": [
            "h",
            "0x"
          ],
          "enumDescriptions": [
            "XG5000 style: h00FF",
            "C style: 0x00FF"
          ],
          "default": "h",
          "scope": "window",
          "description": "Hexadecimal prefix for ladder operand display and editing. Project files retain native literal syntax."
        }
      }
    }
  },
  "scripts": {
    "check": "node --check extension.js && node --check media/main.js && node --check media/inline-properties.js && node --check scripts/launch-extension-host.cjs && node --check media/ladder-operand-rules.cjs && node --check media/variable-edit.js && node --check password-prompts.cjs && node --check new-workspace.cjs && node --check explorer.cjs && node --check media/explorer-model.js && node --check media/tasks.js",
    "test": "node --test test/*.test.js test/*.test.mjs",
    "build:wasm": "bash scripts/build-wasm.sh",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.6.0"
  }
}
