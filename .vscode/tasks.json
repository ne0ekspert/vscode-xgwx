{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Launch XGWX Extension Host",
      "type": "process",
      "command": "code",
      "args": [
        "--new-window",
        "--extensionDevelopmentPath=${workspaceFolder}",
        "--inspect-brk-extensions=9230"
      ],
      "problemMatcher": []
    },
    {
      "label": "Check extension",
      "type": "npm",
      "script": "check",
      "problemMatcher": []
    },
    {
      "label": "Test extension",
      "type": "npm",
      "script": "test",
      "problemMatcher": []
    }
  ]
}
