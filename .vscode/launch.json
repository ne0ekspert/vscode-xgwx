{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run XGWX Workspace Viewer",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "node",
      "program": "${workspaceFolder}/scripts/launch-extension-host.cjs",
      "args": [
        "${execPath}",
        "${workspaceFolder}",
        "9230"
      ],
      "attachSimplePort": 9230,
      "timeout": 30000,
      "killBehavior": "polite",
      "skipFiles": [
        "<node_internals>/**"
      ],
      "preLaunchTask": "Check extension"
    }
  ]
}
